{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "app/(app)/servicios/[id].jsx",
    "app/(app)/servicios/index.jsx",
    "app/(app)/_layout.jsx"
, "app/_layout.jsx"  ]
}
